{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  // Custom managers only: base images and actions belong to Dependabot
  // (.github/dependabot.yml), which is native and may write to
  // .github/workflows/. What is left here are the versions that live inside a
  // file, which Dependabot cannot read.
  enabledManagers: ["custom.regex"],
  customManagers: [
    {
      // DepotDownloader. Bumping it re-pins the zip's sha256 through a
      // post-upgrade task (see packageRules).
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: ["ARG DEPOTDOWNLOADER_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "SteamRE/DepotDownloader",
      datasourceTemplate: "github-releases",
      // releases are tagged DepotDownloader_3.4.0
      extractVersionTemplate: "^DepotDownloader_(?<version>.+)$",
    },
    {
      // GE-Proton, the ARG the workflow also reads the image tag from. In a
      // file under .github/workflows/ this would not work: the Actions token
      // may not write there, so the PR would never be created.
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: ["ARG PROTON_VERSION=(?<currentValue>[0-9-]+)"],
      depNameTemplate: "GloriousEggroll/proton-ge-custom",
      datasourceTemplate: "github-releases",
      // releases are tagged GE-Proton11-11: neither semver nor anything like
      // it, so the ordering is spelled out here
      extractVersionTemplate: "^GE-Proton(?<version>.+)$",
      versioningTemplate: "regex:^(?<major>\\d+)-(?<minor>\\d+)$",
    },
  ],
  packageRules: [
    {
      description: "DepotDownloader: re-pin the zip's sha256 on a bump",
      matchDepNames: ["SteamRE/DepotDownloader"],
      postUpgradeTasks: {
        commands: ["./scripts/pin-depotdownloader.sh {{{newValue}}}"],
        fileFilters: ["proton/Dockerfile"],
        executionMode: "update",
      },
    },
    {
      description: "GE-Proton: re-pin the published sha512 on a bump, one PR per release",
      matchDepNames: ["GloriousEggroll/proton-ge-custom"],
      separateMinorPatch: true,
      postUpgradeTasks: {
        commands: ["./scripts/pin-proton.sh {{{newValue}}}"],
        fileFilters: ["proton/Dockerfile"],
        executionMode: "update",
      },
    },
  ],
}
