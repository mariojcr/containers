{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  // Solo los managers propios: las imágenes base y las actions las lleva
  // Dependabot (.github/dependabot.yml), que es nativo y sí puede escribir en
  // .github/workflows/. Aquí quedan las versiones sueltas dentro de ficheros,
  // que Dependabot no sabe leer.
  enabledManagers: ["custom.regex"],
  customManagers: [
    {
      // DepotDownloader: el ARG del Dockerfile. Al subirlo, un postUpgradeTask
      // recalcula el sha256 (ver packageRules).
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: ["ARG DEPOTDOWNLOADER_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "SteamRE/DepotDownloader",
      datasourceTemplate: "github-releases",
      // las releases se etiquetan DepotDownloader_3.4.0
      extractVersionTemplate: "^DepotDownloader_(?<version>.+)$",
    },
    {
      // GE-Proton: el ARG del Dockerfile, que es de donde el workflow saca el
      // tag. En un fichero de .github/workflows/ no valdría: el GITHUB_TOKEN
      // de Actions no puede escribir ahí y la PR nunca llegaría a crearse.
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: ["ARG PROTON_VERSION=(?<currentValue>[0-9-]+)"],
      depNameTemplate: "GloriousEggroll/proton-ge-custom",
      datasourceTemplate: "github-releases",
      // las releases se etiquetan GE-Proton11-7: ni semver ni nada parecido,
      // así que el orden se define a mano
      extractVersionTemplate: "^GE-Proton(?<version>.+)$",
      versioningTemplate: "regex:^(?<major>\\d+)-(?<minor>\\d+)$",
    },
  ],
  packageRules: [
    {
      description: "DepotDownloader: al subir la versión, repinchar el sha256 del zip",
      matchDepNames: ["SteamRE/DepotDownloader"],
      postUpgradeTasks: {
        commands: ["./scripts/pin-depotdownloader.sh {{{newValue}}}"],
        fileFilters: ["proton/Dockerfile"],
        executionMode: "update",
      },
    },
    {
      description: "GE-Proton: una PR por versión, que cada una cambia el tag publicado",
      matchDepNames: ["GloriousEggroll/proton-ge-custom"],
      separateMinorPatch: true,
    },
  ],
}
